# ---------------------------------------------------------------------------
# KitabDostu backend — environment
# Copy to `.env` and adjust. `.env` is git-ignored.
#
#   cp .env.example .env
#
# NO REAL CREDENTIALS LIVE IN THIS FILE. Every variable below is a placeholder.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# --- database --------------------------------------------------------------
# For docker-compose, also set POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
# in this file — compose reads the same .env.
#
# Docker exposes Postgres on port 5544 (not 5432) to avoid clashing with a
# native install. If 5544 is taken, change it here AND in docker-compose.yml.
POSTGRES_USER=change-me-db-user
POSTGRES_PASSWORD=change-me-strong-random-password
POSTGRES_DB=change-me-db-name
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5544/${POSTGRES_DB}?schema=public

# --- auth ------------------------------------------------------------------
JWT_ACCESS_SECRET=change-this-in-local-env-long-random
JWT_REFRESH_SECRET=change-this-in-local-env-long-random
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- CORS ------------------------------------------------------------------
# Comma-separated. Expo web runs on 8081; the Expo Go dev client uses exp://.
# A phone on the LAN reaches the API by IP, and browsers send that origin, so
# add your LAN IP here when testing on a device.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,exp://127.0.0.1:8081

# --- locale ----------------------------------------------------------------
# Reading streaks and daily buckets are computed in this timezone. Keep it as
# Asia/Baku unless you know why you are changing it — UTC days would cost a
# Baku reader their streak every time they read after 20:00.
DEFAULT_TIMEZONE=Asia/Baku
DEFAULT_LOCALE=az

# --- integrations (all optional in development) ----------------------------
# Every integration below runs as a stub when its key is absent: the interface
# is real, the network call is not. See src/integrations/README.md.

# Payriff / MilliKart — card payments
PAYRIFF_MERCHANT_ID=
PAYRIFF_SECRET_KEY=
PAYRIFF_BASE_URL=https://api.payriff.com/api/v2

# OAuth
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_APP_ID=

# S3-compatible storage for uploads (AWS S3, Cloudflare R2, MinIO)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# SMS (order notifications)
SMS_PROVIDER_KEY=
SMS_SENDER=KitabDostu

# Expo push notifications
EXPO_PUSH_ACCESS_TOKEN=

# OCR for the quote scanner — must handle ə ğ ı ö ş ü ç
OCR_PROVIDER=stub
OCR_PROVIDER_KEY=

# Google Books, used to enrich the catalogue
GOOGLE_BOOKS_API_KEY=

# --- mail ------------------------------------------------------------------
# Password-reset links. Without SMTP_HOST the reset token is logged to the
# console instead of emailed, which is what you want in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=KitabDostu <noreply@kitabdostu.az>
APP_RESET_URL=http://localhost:8081/reset-password

# ---------------------------------------------------------------------------
# Dev-script / one-off variables (all optional, defaults are fine for Docker)
# ---------------------------------------------------------------------------

# PostgreSQL connection helpers (used by scripts/*.mjs and scripts/*.ps1 that
# talk to the database directly). When using docker-compose these match the
# POSTGRES_* values above.
PGHOST=localhost
PGPORT=5544
APP_PGUSER=${POSTGRES_USER}
APP_PGPASSWORD=${POSTGRES_PASSWORD}
PGDATABASE=${POSTGRES_DB}

# PostgreSQL superuser (scripts/setup-local-pg.mjs, scripts/fix-privs.mjs).
# Only needed when you set up a brand-new native PostgreSQL installation.
# Leave empty on a trust-auth or Docker-backed install.
PSQL_PATH=
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=

# Database seeding — `npm run seed` assigns this password to every seeded
# account so you can sign in during development.
SEED_PASSWORD=change-me-dev-password

# Admin login used by the PowerShell maintenance scripts and smoke tests.
# Admin user itself is created by prisma/seed.ts.
API_BASE=http://localhost:4000/api/v1
ADMIN_EMAIL=admin@kitabdostu.az
ADMIN_PASSWORD=${SEED_PASSWORD}

# Smoke tests — sign in as this user (matches any seeded user's email + the
# shared SEED_PASSWORD from above).
SMOKE_EMAIL=leyla@kitabdostu.az
SMOKE_PASSWORD=${SEED_PASSWORD}
TEST_PASSWORD=${SEED_PASSWORD}
